[Unit]
Description=TempDrop temporary pastebin and file storage
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tempdrop
Group=tempdrop
ExecStart=/usr/local/bin/tempdrop /etc/tempdrop/config.json
Restart=on-failure
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/tempdrop
MemoryMax=2800M
TasksMax=256
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
